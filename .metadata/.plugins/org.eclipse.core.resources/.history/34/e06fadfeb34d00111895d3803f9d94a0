        btnAtualizar = new JButton("🔄 Atualizar");
        btnSolicitarCompra = new JButton("📦 Solicitar Compra");
        JButton btnVerProduto = new JButton("🔍 Ver Detalhes");
        
        btnAtualizar.setBackground(new Color(70, 130, 180));
        btnAtualizar.setForeground(Color.WHITE);
        btnAtualizar.setFont(new Font("Arial", Font.BOLD, 12));
        
        btnSolicitarCompra.setBackground(new Color(60, 120, 60));
        btnSolicitarCompra.setForeground(Color.WHITE);
        btnSolicitarCompra.setFont(new Font("Arial", Font.BOLD, 12));
        
        btnVerProduto.setBackground(new Color(100, 100, 200));
        btnVerProduto.setForeground(Color.WHITE);
        btnVerProduto.setFont(new Font("Arial", Font.BOLD, 12));
        
        btnAtualizar.addActionListener(e -> carregarProdutosEstoqueBaixo());
        btnSolicitarCompra.addActionListener(e -> solicitarCompra());
        btnVerProduto.addActionListener(e -> verDetalhesProduto());
        
        painelBotoes.add(btnAtualizar);
        painelBotoes.add(btnSolicitarCompra);
