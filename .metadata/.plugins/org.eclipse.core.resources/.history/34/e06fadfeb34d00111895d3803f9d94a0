        painelStats.setBackground(new Color(240, 248, 255));
        
        JLabel lblTotalProdutos = new JLabel();
        JLabel lblTotalZero = new JLabel();
        JLabel lblTotalCritico = new JLabel();
        
        painelStats.add(lblTotalProdutos);
        painelStats.add(Box.createHorizontalStrut(20));
        painelStats.add(lblTotalZero);
        painelStats.add(Box.createHorizontalStrut(20));
        painelStats.add(lblTotalCritico);
        
        // Atualizar estatísticas periodicamente
