package com.monitoramento.ui;

import com.monitoramento.model.ProdutoEstoque;
import com.monitoramento.model.Usuario;
import com.monitoramento.dao.ProdutoEstoqueDAO;

import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import javax.swing.table.DefaultTableCellRenderer;
import java.awt.*;
import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.List;
import java.util.ArrayList;

public class TelaEstoqueBaixo extends JPanel {
    private ProdutoEstoqueDAO produtoDAO;
    private Usuario usuarioLogado;
    
    private JTable tabelaProdutos;
    private DefaultTableModel tableModel;
    private JButton btnAtualizar, btnSolicitarCompra;
    private javax.swing.Timer timerAtualizacao;
    
    // Cores para diferentes níveis de alerta
    private static final Color COR_CRITICO = new Color(255, 200, 200);
    private static final Color COR_ALERTA = new Color(255, 240, 200);
    private static final Color COR_ZERO = new Color(255, 180, 180);
    
    public TelaEstoqueBaixo(Usuario usuario) {
        this.usuarioLogado = usuario;
        this.produtoDAO = new ProdutoEstoqueDAO();
        
        initComponents();
        carregarProdutosEstoqueBaixo();
        
        // Registrar esta tela para receber notificações da TelaEstoque
        TelaEstoque.registrarTelaEstoqueBaixo(this);
        
        // Iniciar timer para atualização automática a cada 5 segundos
        iniciarTimerAtualizacao();
    }
    
    @Override
    public void removeNotify() {
        super.removeNotify();
        TelaEstoque.removerTelaEstoqueBaixo(this);
        if (timerAtualizacao != null) {
            timerAtualizacao.stop();
        }
    }
    
    private void iniciarTimerAtualizacao() {
        timerAtualizacao = new javax.swing.Timer(5000, e -> {
            SwingUtilities.invokeLater(() -> {
                if (isVisible()) {
                    carregarProdutosEstoqueBaixo();
                }
            });
        });
        timerAtualizacao.start();
    }
    
    /**
     * Método público para atualizar a lista (chamado pela TelaEstoque)
     */
    public void atualizarLista() {
        SwingUtilities.invokeLater(() -> carregarProdutosEstoqueBaixo());
    }
    
    private void initComponents() {
        setLayout(new BorderLayout());
        setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));
        
        // Painel de informações
        JPanel painelInfo = new JPanel();
        painelInfo.setBackground(new Color(255, 200, 200));
        painelInfo.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));
        
        JLabel lblInfo = new JLabel("⚠️ ATENÇÃO: Produtos com quantidade abaixo do estoque mínimo!");
        lblInfo.setFont(new Font("Arial", Font.BOLD, 14));
        lblInfo.setForeground(Color.RED);
        painelInfo.add(lblInfo);
        
        // Tabela
        String[] colunas = {"ID", "Código", "Nome", "Categoria", "Quantidade Atual", "Quantidade Mínima", "Déficit", "Localização", "Status"};
        tableModel = new DefaultTableModel(colunas, 0) {
            @Override
            public boolean isCellEditable(int row, int column) {
