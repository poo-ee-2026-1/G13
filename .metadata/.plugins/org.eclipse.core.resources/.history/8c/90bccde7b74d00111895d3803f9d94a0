    private void atualizarEstatisticas() {
        if (lblTotalProdutos == null) return;
        
        int total = tableModel.getRowCount();
        int zero = 0;
        int critico = 0;
        
        for (int i = 0; i < tableModel.getRowCount(); i++) {
            try {
                Object qtdObj = tableModel.getValueAt(i, 4);
                Object minObj = tableModel.getValueAt(i, 5);
                
                if (qtdObj != null && minObj != null) {
                    int qtd = 0;
                    int min = 0;
                    
                    if (qtdObj instanceof Integer) {
                        qtd = (Integer) qtdObj;
                    } else if (qtdObj instanceof String) {
                        qtd = Integer.parseInt((String) qtdObj);
                    }
                    
                    if (minObj instanceof Integer) {
                        min = (Integer) minObj;
                    } else if (minObj instanceof String) {
                        min = Integer.parseInt((String) minObj);
                    }
                    
                    if (qtd == 0 && min > 0) {
                        zero++;
                    } else if (min > 0 && qtd > 0 && qtd * 100 / min <= 10) {
                        critico++;
                    }
                }
            } catch (Exception ex) {
                // Ignorar
            }
        }
        
        lblTotalProdutos.setText("📦 Total com estoque baixo: " + total);
        lblTotalZero.setText("⚠️ Estoque ZERO: " + zero);
        lblTotalCritico.setText("🟡 Crítico (<10%): " + critico);
        
        if (zero > 0) {
            lblTotalZero.setForeground(Color.RED);
            lblTotalZero.setFont(new Font("Arial", Font.BOLD, 12));
        } else {
            lblTotalZero.setForeground(new Color(0, 100, 0));
            lblTotalZero.setFont(new Font("Arial", Font.PLAIN, 12));
        }
        
        if (critico > 0) {
            lblTotalCritico.setForeground(new Color(255, 140, 0));
            lblTotalCritico.setFont(new Font("Arial", Font.BOLD, 12));
        } else {
            lblTotalCritico.setForeground(new Color(0, 100, 0));
            lblTotalCritico.setFont(new Font("Arial", Font.PLAIN, 12));
        }
        
        if (total > 0) {
            lblTotalProdutos.setForeground(new Color(0, 100, 0));
            lblTotalProdutos.setFont(new Font("Arial", Font.BOLD, 12));
        } else {
            lblTotalProdutos.setForeground(Color.GRAY);
            lblTotalProdutos.setFont(new Font("Arial", Font.PLAIN, 12));
        }
    }
    
    private void carregarProdutosEstoqueBaixo() {
        System.out.println("[ESTOQUE BAIXO] ========== INICIANDO CARREGAMENTO ==========");
        
        // Limpar tabela
        tableModel.setRowCount(0);
        
        // Buscar todos os produtos
        List<ProdutoEstoque> todosProdutos = produtoDAO.listarTodos();
        
        if (todosProdutos == null || todosProdutos.isEmpty()) {
            System.out.println("[ESTOQUE BAIXO] Nenhum produto cadastrado!");
            lblStatusInfo.setText("Nenhum produto cadastrado no sistema.");
            mostrarPainelVazio();
            return;
        }
        
        System.out.println("[ESTOQUE BAIXO] Total de produtos no sistema: " + todosProdutos.size());
        
        // Filtrar apenas produtos com estoque baixo (quantidade <= quantidade mínima)
        List<ProdutoEstoque> produtosBaixo = new ArrayList<>();
        for (ProdutoEstoque p : todosProdutos) {
            boolean isAtivo = p.isAtivo();
            int quantidade = p.getQuantidade();
            int quantidadeMinima = p.getQuantidadeMinima();
            boolean estoqueBaixo = quantidade <= quantidadeMinima;
            
            System.out.println("[ESTOQUE BAIXO] Produto ID " + p.getId() + 
                ": " + p.getNome() + 
                " | Ativo: " + isAtivo +
                " | Qtd: " + quantidade + 
                " | Mínimo: " + quantidadeMinima + 
                " | Estoque Baixo: " + estoqueBaixo);
            
            if (isAtivo && estoqueBaixo) {
                produtosBaixo.add(p);
                System.out.println("[ESTOQUE BAIXO] >>> ADICIONADO à lista de estoque baixo!");
            }
        }
        
        System.out.println("[ESTOQUE BAIXO] Total de produtos com estoque baixo: " + produtosBaixo.size());
        lblStatusInfo.setText("Encontrados " + produtosBaixo.size() + " produtos com estoque baixo.");
        
        CardLayout cl = (CardLayout) ((JPanel) ((BorderLayout) getLayout()).getLayoutComponent(BorderLayout.CENTER)).getLayout();
        JPanel painelCentral = (JPanel) ((BorderLayout) getLayout()).getLayoutComponent(BorderLayout.CENTER);
        
        if (produtosBaixo.isEmpty()) {
            System.out.println("[ESTOQUE BAIXO] Nenhum produto com estoque baixo - exibindo mensagem vazia");
            mostrarPainelVazio();
            return;
        }
        
        // Mostrar tabela
        System.out.println("[ESTOQUE BAIXO] Exibindo tabela com " + produtosBaixo.size() + " produtos");
        cl.show(painelCentral, "TABELA");
        btnSolicitarCompra.setEnabled(true);
        btnVerProduto.setEnabled(true);
        
        // Ordenar por criticidade
        produtosBaixo.sort((a, b) -> {
            if (a.getQuantidade() == 0 && b.getQuantidade() != 0) return -1;
            if (a.getQuantidade() != 0 && b.getQuantidade() == 0) return 1;
            
            int percentA = a.getQuantidadeMinima() > 0 ? (a.getQuantidade() * 100) / a.getQuantidadeMinima() : 0;
            int percentB = b.getQuantidadeMinima() > 0 ? (b.getQuantidade() * 100) / b.getQuantidadeMinima() : 0;
            return Integer.compare(percentA, percentB);
        });
        
        for (ProdutoEstoque p : produtosBaixo) {
            int deficit = p.getQuantidadeMinima() - p.getQuantidade();
            if (deficit < 0) deficit = 0;
            
            int percentual = p.getQuantidadeMinima() > 0 ? (p.getQuantidade() * 100) / p.getQuantidadeMinima() : 0;
            String status;
            
            if (p.getQuantidade() == 0) {
                status = "⚠️ ZERO - URGENTE!";
            } else if (percentual <= 10) {
                status = "🟡 CRÍTICO (" + percentual + "%)";
            } else {
                status = "⚠️ BAIXO (" + percentual + "%)";
            }
            
            Object[] row = {
                p.getId(),
                p.getCodigo(),
                p.getNome(),
                p.getCategoria(),
                p.getQuantidade(),
                p.getQuantidadeMinima(),
                deficit,
                p.getLocalizacao() != null ? p.getLocalizacao() : "---",
                status
            };
            tableModel.addRow(row);
            
            System.out.println("[ESTOQUE BAIXO] Adicionado à tabela: " + p.getNome() + " - Qtd: " + p.getQuantidade() + "/" + p.getQuantidadeMinima());
        }
        
        // Se houver apenas 1 linha, selecionar automaticamente
        if (tableModel.getRowCount() == 1) {
            tabelaProdutos.setRowSelectionInterval(0, 0);
        }
        
        System.out.println("[ESTOQUE BAIXO] ========== CARREGAMENTO CONCLUÍDO ==========");
    }
    
