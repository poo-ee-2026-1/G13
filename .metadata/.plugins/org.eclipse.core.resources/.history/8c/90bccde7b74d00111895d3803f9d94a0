    }
    
    private void solicitarCompra() {
        int row = tabelaProdutos.getSelectedRow();
        if (row < 0 || tableModel.getRowCount() == 0) {
            JOptionPane.showMessageDialog(this, "Selecione um produto para solicitar compra!");
            return;
        }
        
        int idProduto = (int) tableModel.getValueAt(row, 0);
        String nomeProduto = (String) tableModel.getValueAt(row, 2);
        int quantidadeAtual = (int) tableModel.getValueAt(row, 4);
        int quantidadeMinima = (int) tableModel.getValueAt(row, 5);
        int deficit = (int) tableModel.getValueAt(row, 6);
        
        ProdutoEstoque produto = produtoDAO.buscarPorId(idProduto);
        if (produto == null) {
            JOptionPane.showMessageDialog(this, "Produto não encontrado!");
            return;
        }
        
        JPanel panel = new JPanel(new GridBagLayout());
        GridBagConstraints gbc = new GridBagConstraints();
        gbc.insets = new Insets(5, 5, 5, 5);
        gbc.fill = GridBagConstraints.HORIZONTAL;
        
        gbc.gridx = 0; gbc.gridy = 0;
        panel.add(new JLabel("Produto:"), gbc);
        gbc.gridx = 1;
        panel.add(new JLabel(nomeProduto), gbc);
        
        gbc.gridx = 0; gbc.gridy = 1;
        panel.add(new JLabel("Quantidade Atual:"), gbc);
        gbc.gridx = 1;
        panel.add(new JLabel(String.valueOf(quantidadeAtual) + " " + produto.getUnidadeMedida()), gbc);
        
        gbc.gridx = 0; gbc.gridy = 2;
        panel.add(new JLabel("Quantidade Mínima:"), gbc);
        gbc.gridx = 1;
        panel.add(new JLabel(String.valueOf(quantidadeMinima) + " " + produto.getUnidadeMedida()), gbc);
        
        gbc.gridx = 0; gbc.gridy = 3;
        panel.add(new JLabel("Déficit:"), gbc);
        gbc.gridx = 1;
        panel.add(new JLabel(String.valueOf(deficit) + " " + produto.getUnidadeMedida()), gbc);
        
        gbc.gridx = 0; gbc.gridy = 4;
        panel.add(new JLabel("Quantidade Recomendada:"), gbc);
        int recomendado = Math.max(deficit, produto.getQuantidadeMinima());
        JSpinner spQuantidade = new JSpinner(new SpinnerNumberModel(recomendado, 1, 1000, 1));
        gbc.gridx = 1;
        panel.add(spQuantidade, gbc);
        
        gbc.gridx = 0; gbc.gridy = 5;
        panel.add(new JLabel("Prioridade:"), gbc);
        JComboBox<String> comboPrioridade = new JComboBox<>(new String[]{"NORMAL", "URGENTE", "CRÍTICA"});
        if (quantidadeAtual == 0) {
            comboPrioridade.setSelectedItem("CRÍTICA");
        } else if (quantidadeMinima > 0 && quantidadeAtual * 100 / quantidadeMinima <= 10) {
            comboPrioridade.setSelectedItem("URGENTE");
        }
        gbc.gridx = 1;
        panel.add(comboPrioridade, gbc);
        
        gbc.gridx = 0; gbc.gridy = 6;
        panel.add(new JLabel("Justificativa:"), gbc);
        JTextArea txtJustificativa = new JTextArea(3, 30);
        txtJustificativa.setLineWrap(true);
        String justificativaDefault = "Reposição de estoque - quantidade abaixo do mínimo (" + 
            quantidadeAtual + "/" + quantidadeMinima + ")";
        txtJustificativa.setText(justificativaDefault);
        JScrollPane scrollJust = new JScrollPane(txtJustificativa);
        gbc.gridx = 1;
        panel.add(scrollJust, gbc);
        
        int result = JOptionPane.showConfirmDialog(this, panel, 
            "Solicitar Compra - " + nomeProduto, JOptionPane.OK_CANCEL_OPTION, JOptionPane.PLAIN_MESSAGE);
        
        if (result == JOptionPane.OK_OPTION) {
            int quantidade = (int) spQuantidade.getValue();
            String prioridade = (String) comboPrioridade.getSelectedItem();
            String justificativa = txtJustificativa.getText().trim();
            if (justificativa.isEmpty()) {
                justificativa = justificativaDefault;
            }
            
            double valorTotal = quantidade * produto.getPrecoCusto();
            
            String mensagem = "✅ Solicitação de compra registrada!\n\n" +
                "Produto: " + nomeProduto + "\n" +
                "Quantidade: " + quantidade + " " + produto.getUnidadeMedida() + "\n" +
                "Prioridade: " + prioridade + "\n" +
                "Preço unitário: R$ " + String.format("%.2f", produto.getPrecoCusto()) + "\n" +
                "Valor total estimado: R$ " + String.format("%.2f", valorTotal) + "\n" +
                "Justificativa: " + justificativa + "\n\n" +
                "A solicitação foi registrada. O departamento de compras será notificado.";
            
            JOptionPane.showMessageDialog(this, mensagem, "Solicitação Enviada", JOptionPane.INFORMATION_MESSAGE);
        }
    }
    
    private void verDetalhesProduto() {
        int row = tabelaProdutos.getSelectedRow();
        if (row < 0 || tableModel.getRowCount() == 0) {
            JOptionPane.showMessageDialog(this, "Selecione um produto para ver detalhes!");
            return;
        }
        
        int idProduto = (int) tableModel.getValueAt(row, 0);
        ProdutoEstoque produto = produtoDAO.buscarPorId(idProduto);
        
        if (produto == null) {
            JOptionPane.showMessageDialog(this, "Produto não encontrado!");
            return;
        }
        
        JTextArea txtDetalhes = new JTextArea(15, 50);
        txtDetalhes.setEditable(false);
        txtDetalhes.setFont(new Font("Monospaced", Font.PLAIN, 12));
        
        int deficit = produto.getQuantidadeMinima() - produto.getQuantidade();
        int percentual = produto.getQuantidadeMinima() > 0 ? (produto.getQuantidade() * 100) / produto.getQuantidadeMinima() : 0;
        
        StringBuilder sb = new StringBuilder();
        sb.append("=== DETALHES DO PRODUTO ===\n\n");
        sb.append("ID: ").append(produto.getId()).append("\n");
        sb.append("Código: ").append(produto.getCodigo()).append("\n");
        sb.append("Nome: ").append(produto.getNome()).append("\n");
        sb.append("Categoria: ").append(produto.getCategoria()).append("\n");
        sb.append("Fabricante: ").append(produto.getFabricante() != null ? produto.getFabricante() : "---").append("\n");
        sb.append("Modelo: ").append(produto.getModelo() != null ? produto.getModelo() : "---").append("\n\n");
        
        sb.append("=== ESTOQUE ===\n");
        sb.append("Quantidade Atual: ").append(produto.getQuantidade()).append(" ").append(produto.getUnidadeMedida()).append("\n");
        sb.append("Quantidade Mínima: ").append(produto.getQuantidadeMinima()).append(" ").append(produto.getUnidadeMedida()).append("\n");
        sb.append("Déficit: ").append(deficit).append(" ").append(produto.getUnidadeMedida()).append("\n");
        sb.append("Percentual do mínimo: ").append(String.format("%.1f", (double) percentual)).append("%\n");
        sb.append("Localização: ").append(produto.getLocalizacao() != null ? produto.getLocalizacao() : "---").append("\n\n");
        
        sb.append("=== PREÇOS ===\n");
        sb.append("Preço de Custo: R$ ").append(String.format("%.2f", produto.getPrecoCusto())).append("\n");
        sb.append("Preço de Venda: R$ ").append(String.format("%.2f", produto.getPrecoVenda())).append("\n");
        double margem = produto.getPrecoCusto() > 0 ? (produto.getPrecoVenda() - produto.getPrecoCusto()) * 100 / produto.getPrecoCusto() : 0;
        sb.append("Margem: ").append(String.format("%.1f", margem)).append("%\n\n");
        
        sb.append("=== DESCRIÇÃO ===\n");
        sb.append(produto.getDescricao() != null && !produto.getDescricao().isEmpty() ? produto.getDescricao() : "---").append("\n");
        
        txtDetalhes.setText(sb.toString());
        
        JOptionPane.showMessageDialog(this, new JScrollPane(txtDetalhes), 
            "Detalhes do Produto - " + produto.getNome(), JOptionPane.INFORMATION_MESSAGE);
    }
