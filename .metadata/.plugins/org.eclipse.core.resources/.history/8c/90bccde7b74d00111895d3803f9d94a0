        // Registrar esta tela para receber notificações da TelaEstoque
        TelaEstoque.addEstoqueBaixoListener(this);
        
        carregarProdutosEstoqueBaixo();
        
        // Iniciar timer para atualização automática a cada 10 segundos (fallback)
        iniciarTimerAtualizacao();
    }
    
    @Override
    public void removeNotify() {
        super.removeNotify();
        TelaEstoque.removeEstoqueBaixoListener(this);
        if (timerAtualizacao != null) {
            timerAtualizacao.stop();
        }
    }
    
    private void iniciarTimerAtualizacao() {
        timerAtualizacao = new javax.swing.Timer(10000, e -> {
            SwingUtilities.invokeLater(() -> {
                if (isVisible()) {
                    carregarProdutosEstoqueBaixo();
                }
            });
        });
        timerAtualizacao.start();
    }
    
    /**
