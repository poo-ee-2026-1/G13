    public void atualizarLista() {
        System.out.println("[ESTOQUE BAIXO] atualizarLista() chamado - Recarregando produtos");
        SwingUtilities.invokeLater(() -> {
            carregarProdutosEstoqueBaixo();
            // Mostrar feedback visual
            if (btnAtualizar != null) {
                btnAtualizar.setText("✓ Atualizado!");
                new Timer(1500, evt -> btnAtualizar.setText("🔄 Atualizar")).start();
            }
        });
    }
    
