    private class PrioridadeRenderer extends DefaultTableCellRenderer {
        @Override
        public Component getTableCellRendererComponent(JTable table, Object value,
                boolean isSelected, boolean hasFocus, int row, int column) {
            Component c = super.getTableCellRendererComponent(table, value, isSelected, hasFocus, row, column);
            setHorizontalAlignment(SwingConstants.CENTER);
            
            if (value != null) {
                String prioridade = value.toString();
                if ("ALTA".equals(prioridade)) {
                    c.setForeground(Color.RED);
                    setFont(getFont().deriveFont(Font.BOLD));
                } else if ("MEDIA".equals(prioridade) || "MÉDIA".equals(prioridade)) {
                    c.setForeground(new Color(255, 140, 0));
                    setFont(getFont().deriveFont(Font.BOLD));
                } else {
                    c.setForeground(new Color(0, 100, 0));
                    setFont(getFont().deriveFont(Font.PLAIN));
                }
            }
            
            if (isSelected) {
                c.setBackground(table.getSelectionBackground());
            } else {
                c.setBackground(table.getBackground());
            }
            
            return c;
        }
    }
    
    private void carregarClientesCombo() {
        comboClienteFiltro.removeAllItems();
        comboClienteFiltro.addItem("TODOS");
        List<Cliente> clientes = clienteDAO.listarTodos();
        for (Cliente c : clientes) {
            comboClienteFiltro.addItem(c.getId() + " - " + c.getNomeExibicao());
        }
    }
    
    private String getTipoExibicao(String tipo) {
        return TIPO_EXIBICAO.getOrDefault(tipo, tipo);
    }
    
    private String determinarTipoOs(OrdemServico os) {
        if (os.getTipoOs() != null && !os.getTipoOs().isEmpty()) {
            return getTipoExibicao(os.getTipoOs());
        }
        if (os.isInstalacao()) return "INSTALAÇÃO";
        if (os.isOrcamento()) return "ORÇAMENTO";
        if (os.isInformacao()) return "INFORMAÇÃO";
        if (os.isReparo()) return "REPARO";
        return "SERVIÇO";
    }
    
    private String formatarStatus(String status) {
        if (status == null) return "---";
        switch (status) {
            case "ABERTA": return "ABERTA";
            case "EM_ATENDIMENTO": return "EM ATENDIMENTO";
            case "FECHADA": return "FECHADA";
            default: return status;
        }
    }
    
    private void carregarOrdens() {
        if (osService == null && ordemServicoDAO == null) {
            tableModel.setRowCount(0);
            Object[] row = {"---", "Serviço de OS não disponível", "---", "---", "---", "---", "---", "---", "---", "---"};
            tableModel.addRow(row);
            lblTotalRegistros.setText("Total: 0 registros");
            return;
        }
        
        tableModel.setRowCount(0);
        
        List<OrdemServico> ordens;
        if (osService != null) {
            ordens = osService.listarTodasOS();
        } else {
            ordens = ordemServicoDAO.listarTodas();
        }
        
        // Filtrar por nível do usuário
        ordens = ordens.stream()
            .filter(os -> usuarioLogado.podeVisualizarNivel(os.getTipoNivel()))
            .collect(Collectors.toList());
        
        adicionarOrdensTabela(ordens);
        
        String nivelUsuario = usuarioLogado.getNivelAtendimento() != null ? 
                              usuarioLogado.getNivelAtendimento() : "1º Nível";
        lblStatusInfo.setText("Sistema de OS - Suporte Técnico (ST) | Total de OS: " + ordens.size() + 
            " | Usuário: " + usuarioLogado.getNomeCompleto() + " | Nível: " + nivelUsuario);
        lblTotalRegistros.setText("Total: " + ordens.size() + " registros");
    }
    
    private void filtrarOrdens() {
        if (osService == null && ordemServicoDAO == null) {
            JOptionPane.showMessageDialog(this, "Serviço de OS não disponível!");
            return;
        }
        
        String status = (String) comboFiltroStatus.getSelectedItem();
        String nivel = (String) comboFiltroNivel.getSelectedItem();
        String tipoOsFiltro = (String) comboTipoOsFiltro.getSelectedItem();
        String clienteSelecionado = (String) comboClienteFiltro.getSelectedItem();
        
        List<OrdemServico> ordens;
        if (osService != null) {
            ordens = osService.listarTodasOS();
        } else {
            ordens = ordemServicoDAO.listarTodas();
        }
        
        // Filtrar por nível do usuário
        ordens = ordens.stream()
            .filter(os -> usuarioLogado.podeVisualizarNivel(os.getTipoNivel()))
            .collect(Collectors.toList());
        
        if (!"TODAS".equals(status)) {
            ordens = ordens.stream()
                .filter(os -> os.getStatus() != null && os.getStatus().equals(status))
                .collect(Collectors.toList());
        }
        
        if (!"TODOS".equals(nivel)) {
            ordens = ordens.stream()
                .filter(os -> os.getTipoNivel() != null && os.getTipoNivel().equals(nivel))
                .collect(Collectors.toList());
        }
        
        if (!"TODOS".equals(tipoOsFiltro)) {
            final String tipoFiltro = tipoOsFiltro;
            ordens = ordens.stream()
                .filter(os -> {
                    String tipo = os.getTipoOs();
                    if (tipo == null) return false;
                    if ("INSTALAÇÃO".equals(tipoFiltro)) {
                        return "INSTALACAO".equals(tipo);
                    }
                    return tipo.equals(tipoFiltro);
                })
                .collect(Collectors.toList());
        }
        
        if (clienteSelecionado != null && !"TODOS".equals(clienteSelecionado)) {
            try {
                int idCliente = Integer.parseInt(clienteSelecionado.split(" - ")[0]);
                ordens = ordens.stream()
                    .filter(os -> os.getIdCliente() == idCliente)
                    .collect(Collectors.toList());
            } catch (Exception e) {
                System.err.println("Erro ao filtrar por cliente: " + e.getMessage());
            }
        }
        
        adicionarOrdensTabela(ordens);
    }
    
    private void adicionarOrdensTabela(List<OrdemServico> ordens) {
        tableModel.setRowCount(0);
        SimpleDateFormat sdf = new SimpleDateFormat("dd/MM/yyyy HH:mm");
        
        if (ordens == null || ordens.isEmpty()) {
            Object[] row = {"---", "Nenhum registro encontrado", "---", "---", "---", "---", "---", "---", "---", "---"};
            tableModel.addRow(row);
            lblTotalRegistros.setText("Total: 0 registros");
            return;
        }
        
        List<OrdemServico> ordensOrdenadas = ordens.stream()
            .sorted((a, b) -> Integer.compare(b.getId(), a.getId()))
            .collect(Collectors.toList());
        
        for (OrdemServico os : ordensOrdenadas) {
            Cliente cliente = clienteDAO.buscarPorId(os.getIdCliente());
            String nomeCliente = cliente != null ? cliente.getNomeExibicao() : "N/A";
            
            String tipoOs = determinarTipoOs(os);
            String statusExibicao = formatarStatus(os.getStatus());
            String prioridade = os.getPrioridadeExibicao();
            
            String motivo = os.getMotivo();
            String motivoExibicao = "";
            if (motivo != null && !motivo.isEmpty()) {
                motivoExibicao = motivo.length() > 50 ? motivo.substring(0, 50) + "..." : motivo;
            } else {
                motivoExibicao = "---";
            }
            
            String falha = os.getFalhaIdentificada();
            String falhaExibicao = falha != null && !falha.isEmpty() ? falha : "---";
            
            Object[] row = {
                os.getId(),
                nomeCliente,
                tipoOs,
                os.getTipoNivel() != null ? os.getTipoNivel() : "1º Nível",
                prioridade,
                statusExibicao,
                motivoExibicao,
                os.getDataAbertura() != null ? sdf.format(os.getDataAbertura()) : "",
                os.getDataFechamento() != null ? sdf.format(os.getDataFechamento()) : "",
                falhaExibicao
            };
            tableModel.addRow(row);
        }
        
        lblTotalRegistros.setText("Total: " + ordens.size() + " registros");
    }
    
    private JPanel criarPainelEstatisticas() {
        JPanel panel = new JPanel(new GridBagLayout());
        panel.setBorder(BorderFactory.createTitledBorder("Estatísticas"));
        panel.setPreferredSize(new Dimension(250, 300));
        
        GridBagConstraints gbc = new GridBagConstraints();
        gbc.insets = new Insets(5, 5, 5, 5);
        gbc.fill = GridBagConstraints.HORIZONTAL;
        gbc.gridwidth = 2;
        
        JLabel lblTotalAbertas = new JLabel();
        JLabel lblTotalFechadas = new JLabel();
        JLabel lblTempoMedio = new JLabel();
        JLabel lblProximaOS = new JLabel();
        JLabel lblPorTipo = new JLabel();
        
        gbc.gridx = 0; gbc.gridy = 0;
        panel.add(new JLabel("OS Abertas:"), gbc);
        gbc.gridy = 1;
        panel.add(lblTotalAbertas, gbc);
        
        gbc.gridy = 2;
        panel.add(new JLabel("OS Fechadas (90 dias):"), gbc);
        gbc.gridy = 3;
        panel.add(lblTotalFechadas, gbc);
        
        gbc.gridy = 4;
        panel.add(new JLabel("Tempo Médio Resolução:"), gbc);
        gbc.gridy = 5;
        panel.add(lblTempoMedio, gbc);
        
        gbc.gridy = 6;
        panel.add(new JLabel("Próxima OS 1º Nível:"), gbc);
        gbc.gridy = 7;
        panel.add(lblProximaOS, gbc);
        
        gbc.gridy = 8;
        gbc.gridwidth = 2;
        panel.add(new JSeparator(), gbc);
        
        gbc.gridy = 9;
        panel.add(new JLabel("Distribuição por Tipo:"), gbc);
        gbc.gridy = 10;
        panel.add(lblPorTipo, gbc);
        
        new Timer(5000, e -> {
            List<OrdemServico> abertas;
            if (osService != null) {
                abertas = osService.listarOSAbertas();
            } else {
                abertas = ordemServicoDAO.buscarPorStatus("ABERTA");
            }
            abertas = abertas.stream()
                .filter(os -> usuarioLogado.podeVisualizarNivel(os.getTipoNivel()))
                .collect(Collectors.toList());
            lblTotalAbertas.setText(String.valueOf(abertas.size()));
            
            java.util.Calendar cal = java.util.Calendar.getInstance();
            cal.add(java.util.Calendar.DAY_OF_YEAR, -90);
            Date dataLimite = cal.getTime();
            long fechadas;
            if (osService != null) {
                fechadas = osService.contarOrdensUltimos90Dias();
            } else {
                fechadas = ordemServicoDAO.listarTodas().stream()
                    .filter(os -> "FECHADA".equals(os.getStatus()) && os.getDataFechamento() != null && os.getDataFechamento().after(dataLimite))
                    .count();
            }
            lblTotalFechadas.setText(String.valueOf(fechadas));
            
            double tempoMedio;
            if (osService != null) {
                tempoMedio = osService.calcularTempoMedioResolucaoUltimos90Dias();
            } else {
                tempoMedio = ordemServicoDAO.calcularTempoMedioResolucao(dataLimite, new Date());
            }
            lblTempoMedio.setText(String.format("%.1f horas", tempoMedio));
            
            OrdemServico proxima = abertas.stream()
                .filter(os -> "1º Nível".equals(os.getTipoNivel()))
                .findFirst()
                .orElse(null);
            if (proxima != null) {
                lblProximaOS.setText("OS #" + proxima.getId() + " (" + proxima.getPrioridadeExibicao() + ")");
            } else {
                lblProximaOS.setText("Nenhuma");
            }
            
            // Estatísticas por tipo de OS
            java.util.Map<String, Integer> porTipo = new java.util.HashMap<>();
            List<OrdemServico> todas;
            if (osService != null) {
                todas = osService.listarTodasOS();
            } else {
                todas = ordemServicoDAO.listarTodas();
            }
            for (OrdemServico os : todas) {
                String tipo = os.getTipoOs() != null ? os.getTipoOs() : "OUTRO";
                porTipo.put(tipo, porTipo.getOrDefault(tipo, 0) + 1);
            }
            StringBuilder sbTipo = new StringBuilder("<html>");
            for (java.util.Map.Entry<String, Integer> entry : porTipo.entrySet()) {
                String tipoExib = TIPO_EXIBICAO.getOrDefault(entry.getKey(), entry.getKey());
                sbTipo.append(tipoExib).append(": ").append(entry.getValue()).append("<br>");
            }
            sbTipo.append("</html>");
            lblPorTipo.setText(sbTipo.toString());
        }).start();
        
        return panel;
    }
    
    private void atualizarBotoes() {
        int row = tabelaOrdens.getSelectedRow();
        boolean selecionado = row >= 0 && tableModel.getRowCount() > 0;
        
        if (selecionado) {
            Object statusValue = tableModel.getValueAt(row, 5);
            Object nivelValue = tableModel.getValueAt(row, 3);
            
            if (statusValue == null || nivelValue == null) {
                btnAbrirManual.setEnabled(true);
                btnEscalar.setEnabled(false);
                btnFechar.setEnabled(false);
                return;
            }
            
            String status = statusValue.toString();
            String nivel = nivelValue.toString();
            
            btnAbrirManual.setEnabled(true);
            btnEscalar.setEnabled(!"FECHADA".equals(status));
            btnFechar.setEnabled(!"FECHADA".equals(status));
            
            String nivelUsuario = usuarioLogado.getNivelAtendimento();
            if (nivelUsuario == null) nivelUsuario = "1º Nível";
            
            if ("1º Nível".equals(nivelUsuario) && !"1º Nível".equals(nivel)) {
                btnEscalar.setEnabled(false);
                btnEscalar.setToolTipText("Usuário de 1º Nível não pode escalar OS de nível superior");
            } else if ("2º Nível".equals(nivelUsuario) && "3º Nível".equals(nivel)) {
                btnEscalar.setEnabled(false);
                btnEscalar.setToolTipText("Usuário de 2º Nível não pode escalar OS de 3º Nível");
            } else if ("1º Nível".equals(nivel)) {
                btnEscalar.setToolTipText("Escalar para 2º Nível");
            } else if ("2º Nível".equals(nivel)) {
                btnEscalar.setToolTipText("Escalar para 3º Nível");
            } else if ("3º Nível".equals(nivel)) {
                btnEscalar.setToolTipText("Já está no nível máximo");
                btnEscalar.setEnabled(false);
            }
        } else {
            btnAbrirManual.setEnabled(true);
            btnEscalar.setEnabled(false);
            btnFechar.setEnabled(false);
            btnEscalar.setToolTipText("Selecione uma OS primeiro");
        }
    }
    
    private void abrirOSManual() {
        // CORREÇÃO: Usar OrdemServicoDAO diretamente em vez de osService
        // para evitar chamada ao método onOSCriada inexistente
        
        List<Cliente> todosClientes = clienteDAO.listarTodos();
        List<Equipamento> equipamentos = equipamentoDAO.listarTodos();
        
        if (todosClientes.isEmpty()) {
            JOptionPane.showMessageDialog(this, 
                "⚠️ Nenhum cliente cadastrado!\nCadastre clientes primeiro.", 
                "Aviso", JOptionPane.WARNING_MESSAGE);
            return;
        }
        
        JDialog dialog = new JDialog(SwingUtilities.getWindowAncestor(this), "Abrir Ordem de Serviço - Suporte Técnico (REPARO)", Dialog.ModalityType.APPLICATION_MODAL);
        dialog.setSize(550, 480);
        dialog.setLocationRelativeTo(this);
        dialog.setLayout(new BorderLayout());
        
        JPanel panel = new JPanel(new GridBagLayout());
        panel.setBorder(BorderFactory.createEmptyBorder(15, 15, 15, 15));
        GridBagConstraints gbc = new GridBagConstraints();
        gbc.insets = new Insets(8, 8, 8, 8);
        gbc.fill = GridBagConstraints.HORIZONTAL;
        
        gbc.gridx = 0; gbc.gridy = 0;
        panel.add(new JLabel("Cliente:*"), gbc);
        
        JComboBox<String> comboCliente = new JComboBox<>();
        for (Cliente c : todosClientes) {
            String prioridadeStr = c.getPrioridadeAtendimento() != null ? " [" + c.getPrioridadeAtendimento() + "]" : "";
            comboCliente.addItem(c.getId() + " - " + c.getNomeExibicao() + prioridadeStr);
        }
        gbc.gridx = 1; gbc.gridwidth = 2;
        panel.add(comboCliente, gbc);
        
        gbc.gridx = 0; gbc.gridy = 1;
        gbc.gridwidth = 1;
        panel.add(new JLabel("Motivo (REPARO):*"), gbc);
        
        JTextArea txtMotivo = new JTextArea(5, 35);
        txtMotivo.setLineWrap(true);
        txtMotivo.setWrapStyleWord(true);
        JScrollPane scrollMotivo = new JScrollPane(txtMotivo);
        gbc.gridx = 1; gbc.gridy = 1; gbc.gridwidth = 2;
        panel.add(scrollMotivo, gbc);
        
        JLabel lblInfo = new JLabel("Esta OS será do tipo REPARO e encaminhada para 1º Nível", SwingConstants.CENTER);
        lblInfo.setFont(new Font("Arial", Font.ITALIC, 11));
        lblInfo.setForeground(Color.BLUE);
        gbc.gridy = 2;
        panel.add(lblInfo, gbc);
        
        JPanel botoesPanel = new JPanel(new FlowLayout());
        JButton btnConfirmar = new JButton("Abrir OS (REPARO)");
        JButton btnCancelar = new JButton("Cancelar");
        
        btnConfirmar.setBackground(new Color(60, 120, 60));
        btnConfirmar.setForeground(Color.WHITE);
        btnConfirmar.setFont(new Font("Arial", Font.BOLD, 12));
        
        btnConfirmar.addActionListener(e -> {
            if (comboCliente.getSelectedIndex() == -1) {
                JOptionPane.showMessageDialog(dialog, "Selecione um cliente!");
                return;
            }
            
            String motivo = txtMotivo.getText().trim();
            if (motivo.isEmpty()) {
                JOptionPane.showMessageDialog(dialog, "Informe o motivo da OS!");
                return;
            }
            
            String selected = (String) comboCliente.getSelectedItem();
            int idCliente = Integer.parseInt(selected.split(" - ")[0]);
            Cliente cliente = clienteDAO.buscarPorId(idCliente);
            
            if (cliente == null) {
                JOptionPane.showMessageDialog(dialog, "Cliente não encontrado!");
                return;
            }
            
            // Verificar se cliente possui equipamento
            if (cliente.getEquipamento() == null) {
                int confirmEquip = JOptionPane.showConfirmDialog(dialog,
                    "⚠️ Cliente não possui equipamento cadastrado!\n\n" +
                    "Deseja prosseguir mesmo assim? (Equipamento será vinculado como NÃO ESPECIFICADO)",
                    "Equipamento Não Cadastrado", JOptionPane.YES_NO_OPTION);
                if (confirmEquip != JOptionPane.YES_OPTION) {
                    return;
                }
            }
            
            // Criar OS diretamente pelo DAO (evita chamada ao service)
            OrdemServico os = new OrdemServico();
            os.setIdCliente(idCliente);
            os.setIdEquipamento(cliente.getEquipamento() != null ? cliente.getEquipamento().getId() : 0);
            os.setTipoNivel("1º Nível");
            os.setStatus("ABERTA");
            os.setMotivo(motivo);
            os.setDataAbertura(new Date());
            os.setIdUsuarioAbertura(usuarioLogado.getId());
            os.setTipoOs("REPARO");
            os.setDepartamentoOrigem("SUPORTE_TECNICO");
            os.setTipoOrdem("SERVICO");
            
            if (cliente.getPrioridadeAtendimento() != null) {
                os.setPrioridade(cliente.getPrioridadeAtendimento());
            } else {
                os.setPrioridade("MEDIA");
            }
            
            if (ordemServicoDAO.inserir(os)) {
                JOptionPane.showMessageDialog(dialog, 
                    "✅ OS #" + os.getId() + " (REPARO) aberta com sucesso!\n\n" +
                    "Cliente: " + selected.split(" - ")[1] + "\n" +
                    "Prioridade: " + os.getPrioridadeExibicao() + "\n" +
                    "Motivo: " + motivo);
                dialog.dispose();
                carregarOrdens();
            } else {
                JOptionPane.showMessageDialog(dialog, 
                    "❌ Erro ao abrir OS!\nVerifique os dados do cliente.", 
                    "Erro", JOptionPane.ERROR_MESSAGE);
            }
        });
        
        btnCancelar.addActionListener(e -> dialog.dispose());
        
        botoesPanel.add(btnConfirmar);
        botoesPanel.add(btnCancelar);
        
        dialog.add(panel, BorderLayout.CENTER);
        dialog.add(botoesPanel, BorderLayout.SOUTH);
        dialog.setVisible(true);
    }
    
    private void escalarOrdem() {
        int row = tabelaOrdens.getSelectedRow();
        if (row < 0) {
            JOptionPane.showMessageDialog(this, "Selecione uma OS para escalar!");
            return;
        }
        
        int idOS = (int) tableModel.getValueAt(row, 0);
        String nivelAtual = (String) tableModel.getValueAt(row, 3);
        String status = (String) tableModel.getValueAt(row, 5);
        
        if ("FECHADA".equals(status)) {
            JOptionPane.showMessageDialog(this, "Não é possível escalar uma OS já fechada!");
            return;
        }
        
        String proximoNivel = null;
        if ("1º Nível".equals(nivelAtual)) {
            proximoNivel = "2º Nível";
        } else if ("2º Nível".equals(nivelAtual)) {
            proximoNivel = "3º Nível";
        } else if ("3º Nível".equals(nivelAtual)) {
            JOptionPane.showMessageDialog(this, "⚠️ Esta OS já está no nível máximo!\nNão é possível escalar além deste nível.", 
                "Aviso", JOptionPane.WARNING_MESSAGE);
            return;
        }
        
        String nivelUsuario = usuarioLogado.getNivelAtendimento();
        if (nivelUsuario == null) nivelUsuario = "1º Nível";
        
        if ("1º Nível".equals(nivelUsuario) && !"1º Nível".equals(nivelAtual)) {
            JOptionPane.showMessageDialog(this, 
                "❌ Usuário de 1º Nível não pode escalar OS de nível superior!\n" +
                "Apenas usuários de 2º ou 3º nível podem escalar esta OS.", 
                "Permissão Negada", JOptionPane.WARNING_MESSAGE);
            return;
        }
        if ("2º Nível".equals(nivelUsuario) && "3º Nível".equals(nivelAtual)) {
            JOptionPane.showMessageDialog(this, 
                "❌ Usuário de 2º Nível não pode escalar OS de 3º Nível!\n" +
                "Apenas usuários de 3º nível podem escalar esta OS.", 
                "Permissão Negada", JOptionPane.WARNING_MESSAGE);
            return;
        }
        
        int confirm = JOptionPane.showConfirmDialog(this, 
            "📋 Escalar OS #" + idOS + "\n" +
            "Nível atual: " + nivelAtual + "\n" +
            "Novo nível: " + proximoNivel + "\n\n" +
            "Deseja continuar?", 
            "Confirmar Escalação", JOptionPane.YES_NO_OPTION);
        
        if (confirm == JOptionPane.YES_OPTION) {
            OrdemServico os = ordemServicoDAO.buscarPorId(idOS);
            if (os != null) {
                os.setTipoNivel(proximoNivel);
                if (ordemServicoDAO.atualizar(os)) {
                    JOptionPane.showMessageDialog(this, 
                        "✅ OS #" + idOS + " escalada com sucesso!\n" +
                        "Novo nível: " + proximoNivel);
                    carregarOrdens();
                } else {
                    JOptionPane.showMessageDialog(this, "❌ Erro ao escalar OS!", "Erro", JOptionPane.ERROR_MESSAGE);
                }
            } else {
                JOptionPane.showMessageDialog(this, "OS não encontrada!", "Erro", JOptionPane.ERROR_MESSAGE);
            }
        }
    }
    
    private void fecharOrdem() {
        int row = tabelaOrdens.getSelectedRow();
        if (row < 0) {
            JOptionPane.showMessageDialog(this, "Selecione uma OS para fechar!");
            return;
        }
        
        int idOS = (int) tableModel.getValueAt(row, 0);
        String status = (String) tableModel.getValueAt(row, 5);
        
        if ("FECHADA".equals(status)) {
            JOptionPane.showMessageDialog(this, "Esta OS já está fechada!");
            return;
        }
        
        JPanel panel = new JPanel(new GridBagLayout());
        GridBagConstraints gbc = new GridBagConstraints();
        gbc.insets = new Insets(5, 5, 5, 5);
        gbc.fill = GridBagConstraints.HORIZONTAL;
        
        gbc.gridx = 0; gbc.gridy = 0;
        panel.add(new JLabel("Descrição da Solução:*"), gbc);
        JTextArea txtSolucao = new JTextArea(5, 35);
        txtSolucao.setLineWrap(true);
        txtSolucao.setWrapStyleWord(true);
        JScrollPane scrollSolucao = new JScrollPane(txtSolucao);
        gbc.gridy = 1;
        panel.add(scrollSolucao, gbc);
        
        gbc.gridy = 2;
        panel.add(new JLabel("Falha Identificada:*"), gbc);
        JComboBox<String> comboFalha = new JComboBox<>(new String[]{
            "CLIENTE", "MONITORAMENTO", "INSTALAÇÃO", "HARDWARE", "SOFTWARE", "REDE", "ENERGIA", "OUTRO"
        });
        gbc.gridy = 3;
        panel.add(comboFalha, gbc);
        
        gbc.gridy = 4;
        panel.add(new JLabel("Nível de dificuldade:"), gbc);
        JComboBox<String> comboDificuldade = new JComboBox<>(new String[]{"BAIXA", "MÉDIA", "ALTA", "CRÍTICA"});
        gbc.gridy = 5;
        panel.add(comboDificuldade, gbc);
        
        int result = JOptionPane.showConfirmDialog(this, panel, 
            "Fechar Ordem de Serviço #" + idOS, 
            JOptionPane.OK_CANCEL_OPTION, JOptionPane.PLAIN_MESSAGE);
        
        if (result == JOptionPane.OK_OPTION) {
            String solucao = txtSolucao.getText().trim();
            if (solucao.isEmpty()) {
                JOptionPane.showMessageDialog(this, "Descrição da solução é obrigatória!");
                return;
            }
            
            String falha = (String) comboFalha.getSelectedItem();
            String dificuldade = (String) comboDificuldade.getSelectedItem();
            
            String solucaoCompleta = "[Nível " + dificuldade + "] " + solucao;
            
            OrdemServico os = ordemServicoDAO.buscarPorId(idOS);
            if (os != null && "ABERTA".equals(os.getStatus())) {
                os.setStatus("FECHADA");
                os.setDescricaoSolucao(solucaoCompleta);
                os.setFalhaIdentificada(falha);
                os.setDataFechamento(new Date());
                os.setIdUsuarioFechamento(usuarioLogado.getId());
                
                if (ordemServicoDAO.atualizar(os)) {
                    JOptionPane.showMessageDialog(this, 
                        "✅ OS #" + idOS + " fechada com sucesso!\n\n" +
                        "Falha: " + falha + "\n" +
                        "Dificuldade: " + dificuldade);
                    carregarOrdens();
                } else {
                    JOptionPane.showMessageDialog(this, "❌ Erro ao fechar OS!", "Erro", JOptionPane.ERROR_MESSAGE);
                }
            } else {
                JOptionPane.showMessageDialog(this, "OS não encontrada ou já fechada!", "Erro", JOptionPane.ERROR_MESSAGE);
            }
        }
    }
    
