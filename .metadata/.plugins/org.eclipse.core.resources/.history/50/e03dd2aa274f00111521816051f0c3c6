    private void initComponents() {
        setLayout(new BorderLayout());
        
        // Painel de busca
        JPanel painelBusca = new JPanel(new FlowLayout(FlowLayout.LEFT));
        painelBusca.setBorder(BorderFactory.createTitledBorder("Busca"));
        
        JLabel lblBusca = new JLabel("Documento (CPF/CNPJ):");
        txtBuscaDocumento = new JTextField(20);
        btnBuscar = new JButton("Buscar");
        JButton btnLimparBusca = new JButton("Limpar Busca");
        JButton btnForcarMonitoramento = new JButton("Forçar Reinicialização Monitoramento");
        
        btnBuscar.addActionListener(e -> buscarPorDocumento(txtBuscaDocumento.getText().trim()));
        btnLimparBusca.addActionListener(e -> {
            txtBuscaDocumento.setText("");
            carregarClientes();
        });
        btnForcarMonitoramento.addActionListener(e -> {
            clienteDAO.forcarReinicializacaoTodosClientes();
            JOptionPane.showMessageDialog(this, 
                "Monitoramento reinicializado para todos os clientes!\n" +
                "Verifique o console para detalhes.",
                "Monitoramento Reiniciado", JOptionPane.INFORMATION_MESSAGE);
        });
        
        painelBusca.add(lblBusca);
        painelBusca.add(txtBuscaDocumento);
        painelBusca.add(btnBuscar);
        painelBusca.add(btnLimparBusca);
        painelBusca.add(Box.createHorizontalStrut(20));
        painelBusca.add(btnForcarMonitoramento);
        
        // Tabela
        String[] colunas = {"ID", "Tipo", "Documento", "Nome/Razão Social", "Endereço", "Telefone", "Monitoramento", "IP", "Prioridade", "Equipamento"};
        tableModel = new DefaultTableModel(colunas, 0) {
            @Override
            public boolean isCellEditable(int row, int column) {
                return false;
            }
        };
        
        tabelaClientes = new JTable(tableModel);
        tabelaClientes.setSelectionMode(ListSelectionModel.SINGLE_SELECTION);
        tabelaClientes.addMouseListener(new MouseAdapter() {
            @Override
            public void mouseClicked(MouseEvent e) {
                carregarClienteSelecionado();
            }
        });
        
        JScrollPane scrollTabela = new JScrollPane(tabelaClientes);
        
        // Split pane
        JSplitPane splitPane = new JSplitPane(JSplitPane.VERTICAL_SPLIT);
        splitPane.setResizeWeight(0.5);
        splitPane.setTopComponent(scrollTabela);
        splitPane.setBottomComponent(criarPainelFormulario());
        
        add(painelBusca, BorderLayout.NORTH);
        add(splitPane, BorderLayout.CENTER);
        
        // Toolbar
        JToolBar toolBar = new JToolBar();
        toolBar.setFloatable(false);
        
        JButton btnNovo = new JButton("Novo");
        btnNovo.addActionListener(e -> limparFormulario());
        
        JButton btnRefresh = new JButton("Atualizar");
        btnRefresh.addActionListener(e -> carregarClientes());
        
        toolBar.add(btnNovo);
        toolBar.add(btnRefresh);
        toolBar.add(Box.createHorizontalGlue());
        
        add(toolBar, BorderLayout.SOUTH);
    }
    
